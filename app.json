
{
  "expo": {
    "name": "DRC Golf Tempo",
    "slug": "drc-golf-tempo",
    "version": "1.0.10",
    "orientation": "default",
    "scheme": "drc-golf-tempo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#11151B"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.drc.golftempo",
      "versionCode": 11,
      "allowBackup": false,
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "./plugins/withHealthPrivacy",
      "react-native-health-connect",
      [
        "react-native-ble-plx",
        {
          "neverForLocation": true,
          "isBackgroundEnabled": false
        }
      ],
      "expo-router",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DRC Golf Tempo to record your swing and shot videos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DRC Golf Tempo to calculate live GPS distances and find nearby courses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DRC Golf Tempo to choose swing videos and photos."
        }
      ]
    ]
  }
}
